[Unit]
Description=Autoservis backend (Spring Boot)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=pka
WorkingDirectory=/opt/autoservis
EnvironmentFile=/opt/autoservis/.env
ExecStart=/usr/bin/java -jar /opt/autoservis/target/autoservis-0.0.1-SNAPSHOT.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
